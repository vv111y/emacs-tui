(setq load-prefer-newer t)
(require 'cl-lib)
(require 'emacs-tui-gallery (expand-file-name "../examples/emacs-tui-gallery.el"
                                                   (file-name-directory (or load-file-name buffer-file-name))))
(require 'emacs-tui-popup-demo (expand-file-name "../examples/emacs-tui-popup-demo.el"
                                                      (file-name-directory (or load-file-name buffer-file-name))))

(defvar emacs-tui-popup-smoke--source nil)
(defvar emacs-tui-popup-smoke--window nil)
(defvar emacs-tui-popup-smoke--parent nil)
(defvar emacs-tui-popup-smoke--frames nil)
(defvar emacs-tui-popup-smoke--app nil)
(defvar emacs-tui-popup-smoke--supported nil)
(defvar emacs-tui-popup-smoke--phase 1)
(defvar emacs-tui-popup-smoke--attempts 0)
(defvar emacs-tui-popup-smoke--timer nil)
(defvar emacs-tui-popup-smoke--text nil)
(defvar emacs-tui-popup-smoke--point nil)

(defun emacs-tui-popup-smoke--anchor-probe ()
  ;; Exercise actual redisplay endpoints even on older terminals.
  (dolist (sample '(("日本" . 4) ("é" . 1)))
    (let ((begin (point)) popup)
      (insert (car sample))
      (setq popup (emacs-tui--make-popup
                   :buffer (current-buffer) :begin (copy-marker begin)
                   :end (copy-marker (point) t)))
      (unwind-protect
          (progn
            (redisplay t)
            (cl-assert
             (= (nth 2 (emacs-tui--popup-anchor
                        (emacs-tui--make-workspace :active t :popup popup
                                                   :origin-window (selected-window)
                                                   :origin-frame (selected-frame))))
                (cdr sample))))
        (set-marker (emacs-tui--popup-begin popup) nil)
        (set-marker (emacs-tui--popup-end popup) nil)
        (delete-region begin (point))
        (setq buffer-undo-list nil)))))

(defun emacs-tui-popup-smoke--fail (err)
  (with-temp-file (getenv "EMACS_TUI_SMOKE_REPORT")
    (insert (format "FAIL popup phase %s: %S\n" emacs-tui-popup-smoke--phase err))
    (when (get-buffer "*Messages*")
      (insert (with-current-buffer "*Messages*" (buffer-string)))))
  (kill-emacs 1))

(defun emacs-tui-popup-smoke--host ()
  (cl-assert (eq (selected-window) emacs-tui-popup-smoke--window))
  (cl-assert (eq (selected-frame) emacs-tui-popup-smoke--parent))
  (cl-assert (eq (window-buffer emacs-tui-popup-smoke--window)
                 emacs-tui-popup-smoke--source))
  (cl-assert (= 1 (length (window-list emacs-tui-popup-smoke--parent 'no-minibuffer))))
  (cl-assert (null (window-parameter emacs-tui-popup-smoke--window 'emacs-tui-session))))

(defun emacs-tui-popup-smoke--cycles (app)
  (let ((text (buffer-string)) (point (point)) (undo (cl-remove nil buffer-undo-list))
        (edges (window-edges)) (selected (emacs-tui-current-item app)) positions)
    (dotimes (_ 8)
      (execute-kbd-macro (kbd "C-c C-p"))
      (redisplay t)
      (emacs-tui-popup-smoke--host)
      (let* ((child (emacs-tui--workspace-frame app))
             (actual (list (frame-parameter child 'left) (frame-parameter child 'top)))
             (expected
              (emacs-tui-layout-popup
               (emacs-tui--popup-anchor app) (frame-pixel-width child) (frame-pixel-height child)
               (list 0 0 (frame-inner-width emacs-tui-popup-smoke--parent)
                     (frame-inner-height emacs-tui-popup-smoke--parent))
               emacs-tui-popup-demo--position
               (cons (frame-char-width emacs-tui-popup-smoke--parent)
                     (frame-char-height emacs-tui-popup-smoke--parent)))))
        (cl-assert (equal (frame-position child) (cons (car expected) (cadr expected))) nil
                   "Native popup position=%S expected=%S" (frame-position child) expected)
        (cl-assert (equal actual (cl-subseq expected 0 2)) nil
                   "Popup %S actual=%S expected=%S anchor=%S child=%S parent-cell=%S"
                   emacs-tui-popup-demo--position actual expected
                   (emacs-tui--popup-anchor app)
                   (list (frame-width child) (frame-height child))
                   (cons (frame-char-width emacs-tui-popup-smoke--parent)
                         (frame-char-height emacs-tui-popup-smoke--parent)))
        (push actual positions))
      (cl-assert (equal selected (emacs-tui-current-item app)))
      (cl-assert (equal text (buffer-string)))
      (cl-assert (= point (point)))
      (cl-assert (equal edges (window-edges)))
      (cl-assert (equal undo (cl-remove nil buffer-undo-list))))
    (cl-assert (= 8 (length (delete-dups positions))))))

(defun emacs-tui-popup-smoke--coexistence ()
  ;; A modal child remains the typing target while its own field hosts a popup.
  (let ((modal (emacs-tui-mount
                :backend 'child-frame
                :views (list (emacs-tui-input :id 'draft :value "ma")))))
    (goto-char (point-max))
    (redisplay t)
    (let* ((host (selected-window))
           (popup (emacs-tui-popup
                   :begin 1 :end 3 :width 20 :height 4
                   :view (emacs-tui-view :id 'choices :items '("mapcar" "mapconcat")))))
      (cl-assert (eq modal (emacs-tui-current-session)))
      (cl-assert (eq host (selected-window)))
      (emacs-tui-next-item popup)
      (emacs-tui--remember-tty-focus)
      (cl-assert (emacs-tui--workspace-tty-focus modal))
      (cl-assert (not (emacs-tui--tty-child-p popup)))
      (emacs-tui-close popup)
      (cl-assert (eq host (selected-window)))
      (execute-kbd-macro "x")
      (cl-assert (equal "max" (emacs-tui-input-value modal 'draft))))
    (emacs-tui-close modal)))

(defun emacs-tui-popup-smoke--finish ()
  (when emacs-tui-popup-smoke--supported
    (let ((app emacs-tui-popup-smoke--app))
      (delete-frame (emacs-tui--workspace-frame app) t)
      (cl-assert (not (emacs-tui-live-p app)))
      (emacs-tui-popup-demo-mode -1))
    (emacs-tui-popup-smoke--host)
    (emacs-tui-popup-smoke--coexistence)
    (emacs-tui-popup-smoke--host)
    ;; Repurposing the host is a user choice; disposal must not reclaim it.
    (let* ((replacement (generate-new-buffer " *popup alternative*"))
           (popup (emacs-tui-popup
                   :view (emacs-tui-view :id 'a :items '("Alpha")))))
      (switch-to-buffer replacement)
      (emacs-tui--popup-post-command)
      (cl-assert (not (emacs-tui-live-p popup)))
      (cl-assert (eq replacement (window-buffer (selected-window))))
      (switch-to-buffer emacs-tui-popup-smoke--source)
      (kill-buffer replacement))
    (let ((temporary (generate-new-buffer " *popup dying source*")))
      (switch-to-buffer temporary)
      (redisplay t)
      (let ((popup (emacs-tui-popup :view (emacs-tui-view :id 'a :items '("Alpha")))))
        (kill-buffer temporary)
        (cl-assert (not (emacs-tui-live-p popup)))))
    (switch-to-buffer emacs-tui-popup-smoke--source)
    (emacs-tui-popup-smoke--host))
  (cl-assert (equal emacs-tui-popup-smoke--text (buffer-string)))
  (cl-assert (= emacs-tui-popup-smoke--point (point)))
  (cl-assert (null emacs-tui--sessions))
  (cl-assert (equal emacs-tui-popup-smoke--frames (frame-list)))
  (cl-assert (not (memq #'emacs-tui--popup-post-command post-command-hook)))
  (cl-assert (not (memq #'emacs-tui--popup-terminal-deleted delete-terminal-functions)))
  (cl-assert (not (advice-member-p #'emacs-tui--tty-switch-frame #'handle-switch-frame)))
  (cancel-timer emacs-tui-popup-smoke--timer)
  (with-temp-file (getenv "EMACS_TUI_SMOKE_REPORT")
    (insert (if emacs-tui-popup-smoke--supported
                (format "PASS Emacs %s; native TTY popup; host typing/focus/layout preserved; terminal paint marker required; 8 distinct word-relative positions; candidate navigation/filter/accept/undo; Unicode; resize=120->90->140; modal coexistence; source/frame disposal; cleanup\n" emacs-version)
              (format "PASS Emacs %s; native wide/combining glyph bounds; unsupported popup rejected without changing host; no split fallback; resize=120->90->140; native presentation NOT exercised\n" emacs-version))))
  (kill-emacs 0))

(defun emacs-tui-popup-smoke--poll ()
  (condition-case err
      (progn
        (cl-incf emacs-tui-popup-smoke--attempts)
        (when (> emacs-tui-popup-smoke--attempts 100) (error "Popup resize did not settle"))
        (redisplay t)
        (when (and (= (frame-width emacs-tui-popup-smoke--parent)
                      (if (= 1 emacs-tui-popup-smoke--phase) 90 140))
                   (or (not emacs-tui-popup-smoke--supported)
                       (equal (emacs-tui--geometry emacs-tui-popup-smoke--app)
                              (emacs-tui--workspace-geometry emacs-tui-popup-smoke--app))))
          (with-current-buffer emacs-tui-popup-smoke--source
            (emacs-tui-popup-smoke--host)
            (cl-assert (equal emacs-tui-popup-smoke--text (buffer-string)))
            (cl-assert (= emacs-tui-popup-smoke--point (point)))
            (when emacs-tui-popup-smoke--supported
              (let ((child (emacs-tui--workspace-frame emacs-tui-popup-smoke--app)))
                (cl-assert (frame-live-p child))
                (cl-assert (<= 0 (frame-parameter child 'left)
                               (- (frame-inner-width emacs-tui-popup-smoke--parent)
                                  (frame-pixel-width child))))
                (cl-assert (<= 0 (frame-parameter child 'top)
                               (- (frame-inner-height emacs-tui-popup-smoke--parent)
                                  (frame-pixel-height child))))))
            (if (= 1 emacs-tui-popup-smoke--phase)
                (progn (setq emacs-tui-popup-smoke--phase 2 emacs-tui-popup-smoke--attempts 0)
                       (with-temp-file (getenv "EMACS_TUI_SMOKE_READY") (insert "2")))
              (emacs-tui-popup-smoke--finish)))))
    ((error quit) (emacs-tui-popup-smoke--fail err))))

(defun emacs-tui-popup-smoke--start ()
  (condition-case err
      (progn
        (switch-to-buffer (get-buffer-create "*Popup host*"))
        (erase-buffer)
        (insert (make-string 35 ?\n))
        (goto-char (point-min)) (forward-line 17)
        (insert (make-string 58 ?\s))
        (setq buffer-undo-list nil)
        (setq emacs-tui-popup-smoke--source (current-buffer)
              emacs-tui-popup-smoke--window (selected-window)
              emacs-tui-popup-smoke--parent (selected-frame)
              emacs-tui-popup-smoke--frames (frame-list)
              emacs-tui-popup-smoke--supported (emacs-tui-popup-supported-p))
        (emacs-tui-popup-smoke--anchor-probe)
        (if (not emacs-tui-popup-smoke--supported)
            (let ((windows (window-state-get)) (text (buffer-string)))
              (cl-assert (eq 'user-error
                             (condition-case err
                                 (emacs-tui-popup :view (emacs-tui-view :id 'a))
                               (user-error (car err)))))
              (cl-assert (equal windows (window-state-get)))
              (cl-assert (equal text (buffer-string))))
          (let ((gallery (emacs-tui-gallery)))
            (emacs-tui-set-selection gallery 'demos 'popup)
            (execute-kbd-macro (kbd "C-c C-o"))
            (cl-assert (not (emacs-tui-live-p gallery)))
            (cl-assert emacs-tui-popup-demo-mode))
          (emacs-tui-popup-smoke--host)
          (execute-kbd-macro "ma")
          (setq emacs-tui-popup-smoke--app emacs-tui-popup-demo--session)
          (cl-assert (emacs-tui-live-p emacs-tui-popup-smoke--app))
          (cl-assert (eq 'popup (emacs-tui--workspace-backend emacs-tui-popup-smoke--app)))
          (let* ((app emacs-tui-popup-smoke--app)
                 (child (emacs-tui--workspace-frame app)))
            (execute-kbd-macro (kbd "M-n"))
            (cl-assert (equal "mapc" (plist-get (emacs-tui-current-item app) :label)))
            (let ((text (buffer-string)) (buffer-read-only t))
              (cl-assert (eq 'buffer-read-only
                             (condition-case err (emacs-tui-select app)
                               (buffer-read-only (car err)))))
              (cl-assert (emacs-tui-live-p app))
              (cl-assert (equal text (buffer-string))))
            (let ((items (emacs-tui--view-items (emacs-tui--resolve-view app 'candidates))))
              (emacs-tui-update app 'candidates
                                :items (cons (append (car items)
                                                     '(:annotation "FLOATING-CANDIDATES"))
                                             (cdr items))))
            (redisplay t)
            (with-temp-file (getenv "EMACS_TUI_SMOKE_PAINT") (insert "FLOATING-CANDIDATES"))
            (emacs-tui-popup-smoke--cycles app)
            (execute-kbd-macro "p")
            (cl-assert (eq child (emacs-tui--workspace-frame app)))
            (cl-assert (eq app emacs-tui-popup-demo--session))
            (execute-kbd-macro (kbd "TAB"))
            (cl-assert (not (emacs-tui-live-p app)))
            (cl-assert (equal "mapc" (buffer-substring (- (point) 4) (point))))
            (execute-kbd-macro (kbd "C-/"))
            (cl-assert (equal "map" (buffer-substring (- (point) 3) (point))))
            (execute-kbd-macro (kbd "C-g DEL DEL DEL"))
            (execute-kbd-macro "日本")
            (setq emacs-tui-popup-smoke--app emacs-tui-popup-demo--session)
            (cl-assert (emacs-tui-live-p emacs-tui-popup-smoke--app))
            (redisplay t)
            (cl-assert (>= (nth 2 (emacs-tui--popup-anchor emacs-tui-popup-smoke--app)) 4))))
        (emacs-tui-popup-smoke--host)
        (setq emacs-tui-popup-smoke--text (buffer-string)
              emacs-tui-popup-smoke--point (point))
        (with-temp-file (getenv "EMACS_TUI_SMOKE_READY") (insert "1"))
        (setq emacs-tui-popup-smoke--timer (run-at-time 0.05 0.05 #'emacs-tui-popup-smoke--poll)))
    ((error quit) (emacs-tui-popup-smoke--fail err))))

(add-hook 'emacs-startup-hook (lambda () (run-at-time 0.1 nil #'emacs-tui-popup-smoke--start)))
