(defun emacs-tui-multi-popup-smoke--frames (parent)
  "Assert all three native panels belong to PARENT and return their frames."
  (let (frames)
    (dolist (spec emacs-tui-multi-popup-demo--panels)
      (let* ((app (emacs-tui-multi-popup-demo--session (car spec)))
             (child (and app (emacs-tui--workspace-frame app))))
        (cl-assert (frame-live-p child))
        (cl-assert (frame-visible-p child))
        (cl-assert (eq parent (frame-parent child)))
        (when-let* ((position (alist-get (car spec) emacs-tui-multi-popup-demo--positions)))
          (cl-assert (eq position (emacs-tui--popup-position (emacs-tui--workspace-popup app)))))
        (push child frames)))
    (cl-assert (= 3 (length (delete-dups frames))))
    frames))

(defun emacs-tui-multi-popup-smoke--placements (parent)
  "Move each panel with native keys on PARENT and retain placement on reopening."
  (dolist (step '((objects "C-c p 1") (details "C-c p 2") (keys "C-c p 3")))
    (let* ((id (car step)) (app (emacs-tui-multi-popup-demo--session id))
           (start (emacs-tui--popup-position (emacs-tui--workspace-popup app)))
           (siblings
            (mapcar (lambda (entry)
                      (let ((frame (emacs-tui--workspace-frame (cdr entry))))
                        (list (car entry) (cdr entry) frame (frame-position frame))))
                    (cl-remove-if (lambda (entry) (eq id (car entry)))
                                  emacs-tui-multi-popup-demo--sessions))))
      ;; Nine moves visit every requested position and retain one beyond START.
      (dotimes (count 9)
        (execute-kbd-macro (kbd (cadr step)))
        (cl-assert (eq app (emacs-tui-multi-popup-demo--session id)))
        (cl-assert (eq (nth (mod (+ (cl-position start emacs-tui-layout-popup-positions)
                                    count 1) 8) emacs-tui-layout-popup-positions)
                       (alist-get id emacs-tui-multi-popup-demo--positions)))
        (dolist (sibling siblings)
          (cl-assert (eq (nth 1 sibling) (emacs-tui-multi-popup-demo--session (car sibling))))
          (cl-assert (equal (nth 3 sibling) (frame-position (nth 2 sibling)))))
        (emacs-tui-multi-popup-smoke--frames parent))))
  (let ((positions (copy-tree emacs-tui-multi-popup-demo--positions)))
    (cl-assert (= 3 (length positions)))
    (execute-kbd-macro (kbd "C-c 2 C-c 2 C-c 0 C-c 0"))
    (cl-assert (equal positions emacs-tui-multi-popup-demo--positions))
    (emacs-tui-multi-popup-smoke--frames parent)))

(defun emacs-tui-multi-popup-smoke--scroll ()
  "Read Details without disturbing source focus or sibling panels."
  (let* ((app (emacs-tui-multi-popup-demo--session 'details))
         (view (emacs-tui--resolve-view app 'details))
         (window (emacs-tui--view-window view))
         (start (window-start window)) (host (selected-window))
         (siblings
          (mapcar (lambda (id)
                    (let* ((sibling (emacs-tui-multi-popup-demo--session id))
                           (pane (emacs-tui--view-window (emacs-tui--resolve-view sibling id))))
                      (list sibling pane (window-start pane) (window-point pane))))
                  '(objects keys))))
    (execute-kbd-macro (kbd "C-c ]"))
    (redisplay t)
    (cl-assert (> (window-start window) start))
    (let ((scrolled (window-start window)))
      (execute-kbd-macro (kbd "C-c p 2"))
      (redisplay t)
      (cl-assert (= scrolled (window-start window))))
    (execute-kbd-macro (kbd "C-c ["))
    (redisplay t)
    (cl-assert (= start (window-start window)))
    (cl-assert (eq host (selected-window)))
    (dolist (sibling siblings)
      (cl-assert (emacs-tui-live-p (nth 0 sibling)))
      (cl-assert (= (nth 2 sibling) (window-start (nth 1 sibling))))
      (cl-assert (= (nth 3 sibling) (window-point (nth 1 sibling)))))))

(defun emacs-tui-multi-popup-smoke--pan ()
  "Read wide Details lines through native keys, movement and size changes."
  (let* ((app (emacs-tui-multi-popup-demo--session 'details))
         (view (emacs-tui--resolve-view app 'details))
         (window (emacs-tui--view-window view))
         (child (emacs-tui--workspace-frame app))
         (host (selected-window))
         (siblings (mapcar (lambda (id)
                             (let ((s (emacs-tui-multi-popup-demo--session id)))
                               (cons s (emacs-tui--workspace-frame s))))
                           '(objects keys))))
    (execute-kbd-macro (kbd "C-c >"))
    (redisplay t)
    (cl-assert (= 8 (window-hscroll window)))
    (execute-kbd-macro (kbd "C-c ] C-c p 2 C-c C-e"))
    (redisplay t)
    (cl-assert (= 8 (window-hscroll window)))
    (emacs-tui-refresh app)
    (redisplay t)
    (cl-assert (= 8 (window-hscroll window)))
    (execute-kbd-macro (kbd "C-c C-e C-c <"))
    (redisplay t)
    (cl-assert (= 0 (window-hscroll window)))
    (execute-kbd-macro (kbd "C-c > M-n"))
    (redisplay t)
    (cl-assert (= 0 (window-hscroll window)))
    (execute-kbd-macro (kbd "M-p"))
    (let ((text (emacs-tui--view-text view)))
      (execute-kbd-macro (kbd "C-c >"))
      (emacs-tui-update app 'details :text nil :items '("Temporary list"))
      (emacs-tui-refresh app)
      (redisplay t)
      (cl-assert (= 0 (window-hscroll window)))
      (emacs-tui-update app 'details :text text))
    (cl-assert (eq child (emacs-tui--workspace-frame app)))
    (cl-assert (eq host (selected-window)))
    (dolist (sibling siblings)
      (cl-assert (emacs-tui-live-p (car sibling)))
      (cl-assert (eq (cdr sibling) (emacs-tui--workspace-frame (car sibling)))))))

(defun emacs-tui-multi-popup-smoke--pin ()
  "Hold Details while browsing, reopening and releasing through native keys."
  (let* ((app (emacs-tui-multi-popup-demo--session 'details))
         (view (emacs-tui--resolve-view app 'details))
         (text (emacs-tui--view-text view))
         (child (emacs-tui--workspace-frame app))
         (keys (emacs-tui-multi-popup-demo--session 'keys))
         (host (selected-window)))
    (execute-kbd-macro (kbd "C-c ]"))
    (let ((start (window-start (emacs-tui--view-window view))))
      (execute-kbd-macro (kbd "C-c C-d"))
      (cl-assert (= start (window-start (emacs-tui--view-window view))))
      (execute-kbd-macro (kbd "M-n"))
      (cl-assert (equal text (emacs-tui--view-text view)))
      (cl-assert (equal text (with-current-buffer (emacs-tui--view-buffer view)
                                (buffer-string))))
      (cl-assert (= start (window-start (emacs-tui--view-window view))))
      (cl-assert (string-match-p "pinned" (emacs-tui--view-title view)))
      (cl-assert (eq child (emacs-tui--workspace-frame app))))
    (execute-kbd-macro (kbd "C-c 2 M-n C-c 2"))
    (setq app (emacs-tui-multi-popup-demo--session 'details)
          view (emacs-tui--resolve-view app 'details))
    (cl-assert (equal text (emacs-tui--view-text view)))
    (cl-assert (string-match-p "pinned" (emacs-tui--view-title view)))
    (execute-kbd-macro (kbd "C-c C-d"))
    (cl-assert (not emacs-tui-multi-popup-demo--pinned))
    (cl-assert (not (string-match-p "pinned" (emacs-tui--view-title view))))
    (cl-assert (equal (plist-get (emacs-tui-current-item
                                 (emacs-tui-multi-popup-demo--session 'objects)) :text)
                      (emacs-tui--view-text view)))
    (cl-assert (equal (emacs-tui--view-text view)
                      (with-current-buffer (emacs-tui--view-buffer view)
                        (buffer-string))))
    (cl-assert (not (equal text (emacs-tui--view-text view))))
    (cl-assert (eq keys (emacs-tui-multi-popup-demo--session 'keys)))
    (cl-assert (eq host (selected-window)))))

(defun emacs-tui-multi-popup-smoke--size ()
  "Resize the same Details child, retaining source focus and sibling geometry."
  (let* ((host (selected-window))
         (app (emacs-tui-multi-popup-demo--session 'details))
         (child (emacs-tui--workspace-frame app))
         (buffer (emacs-tui--view-buffer (emacs-tui--resolve-view app 'details)))
         (width (frame-width child)) (height (frame-height child))
         (text (with-current-buffer buffer (buffer-string)))
         (siblings
          (mapcar (lambda (id)
                    (let ((frame (emacs-tui--workspace-frame
                                  (emacs-tui-multi-popup-demo--session id))))
                      (list frame (frame-position frame) (frame-width frame) (frame-height frame))))
                  '(objects keys))))
    (execute-kbd-macro (kbd "C-c C-e"))
    (redisplay t)
    (cl-assert (eq child (emacs-tui--workspace-frame app)))
    (cl-assert (eq app (emacs-tui-multi-popup-demo--session 'details)))
    (cl-assert (> (frame-width child) width))
    (cl-assert (> (frame-height child) height))
    (cl-assert (equal text (with-current-buffer buffer (buffer-string))))
    ;; Requests larger than the viewport must clamp without replacing the child
    ;; or losing the application's requested dimensions.  Then recover in place.
    (let ((parent (frame-parent child))
          (popup (emacs-tui--workspace-popup app)))
      (cl-assert (eq app (emacs-tui-resize-popup app 10000 10000)))
      (redisplay t)
      (cl-assert (eq child (emacs-tui--workspace-frame app)))
      (cl-assert (= 10000 (emacs-tui--popup-width popup)))
      (cl-assert (= 10000 (emacs-tui--popup-height popup)))
      (cl-assert (< (frame-width child) 10000))
      (cl-assert (< (frame-height child) 10000))
      (pcase-let ((`(,left . ,top) (frame-position child)))
        (cl-assert (<= 0 left (- (frame-inner-width parent) (frame-pixel-width child))))
        (cl-assert (<= 0 top (- (frame-inner-height parent) (frame-pixel-height child)))))
      (cl-assert (eq host (selected-window)))
      (cl-assert (eq app (emacs-tui-resize-popup app 50 12)))
      (redisplay t)
      (cl-assert (eq child (emacs-tui--workspace-frame app)))
      (cl-assert (= 50 (frame-width child)))
      (cl-assert (= 12 (frame-height child))))
    (let ((expanded (cons (frame-width child) (frame-height child))))
      (execute-kbd-macro (kbd "C-c 2 C-c 2"))
      (setq child (emacs-tui--workspace-frame (emacs-tui-multi-popup-demo--session 'details)))
      (cl-assert (equal expanded (cons (frame-width child) (frame-height child)))))
    (execute-kbd-macro (kbd "C-c C-e"))
    (redisplay t)
    (cl-assert (eq child (emacs-tui--workspace-frame
                          (emacs-tui-multi-popup-demo--session 'details))))
    (cl-assert (= width (frame-width child)))
    (cl-assert (= height (frame-height child)))
    (cl-assert (eq host (selected-window)))
    (dolist (sibling siblings)
      (let ((frame (car sibling)))
        (cl-assert (frame-live-p frame))
        (cl-assert (equal (nth 1 sibling) (frame-position frame)))
        (cl-assert (= (nth 2 sibling) (frame-width frame)))
        (cl-assert (= (nth 3 sibling) (frame-height frame)))))))

(defun emacs-tui-multi-popup-smoke--resize-failure ()
  "Verify a failed native resize releases exactly the affected popup once."
  (let* ((closed 0)
         (app (emacs-tui-popup :view (emacs-tui-view :id 'failure :text "Temporary")
                               :on-close (lambda (_) (cl-incf closed))))
         (child (emacs-tui--workspace-frame app))
         (buffer (emacs-tui--view-buffer (emacs-tui--resolve-view app 'failure)))
         (popup (emacs-tui--workspace-popup app)))
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'emacs-tui--fit-child)
                     (lambda (_) (error "Injected resize fitting failure"))))
            (cl-assert (eq 'user-error
                           (condition-case err (emacs-tui-resize-popup app 50 12)
                             (user-error (car err))))))
          (cl-assert (not (emacs-tui-live-p app)))
          (cl-assert (not (frame-live-p child)))
          (cl-assert (not (buffer-live-p buffer)))
          (cl-assert (not (marker-buffer (emacs-tui--popup-begin popup))))
          (cl-assert (not (marker-buffer (emacs-tui--popup-end popup))))
          (emacs-tui-close app)
          (cl-assert (= 1 closed)))
      (emacs-tui-close app))))

(defun emacs-tui-multi-popup-smoke--departures (source parent)
  "Leave SOURCE through native commands and recreate its panels on PARENT.
Verify both another buffer in the same window and another selected window.
No explicit close is used before checking the old resources."
  (save-window-excursion
    (let ((destination (generate-new-buffer " *multi destination*")))
      (unwind-protect
          (dolist (kind '(buffer window))
            (let* ((host (selected-window))
                   (other (when (eq kind 'window) (split-window-right)))
                   (index emacs-tui-multi-popup-demo--index)
                   (positions (copy-tree emacs-tui-multi-popup-demo--positions))
                   (text (buffer-string)) (position (point))
                   (undo (copy-tree buffer-undo-list))
                   (apps (mapcar #'cdr emacs-tui-multi-popup-demo--sessions))
                   (resources
                    (mapcar
                     (lambda (app)
                       (let ((popup (emacs-tui--workspace-popup app)))
                         (list (emacs-tui--workspace-frame app)
                               (emacs-tui--view-buffer (car (emacs-tui--workspace-views app)))
                               (emacs-tui--popup-begin popup) (emacs-tui--popup-end popup))))
                     apps)))
              (cl-assert (= 3 (length apps)))
              (emacs-tui-multi-popup-smoke--frames parent)
              (dolist (resource resources)
                (cl-assert (buffer-live-p (nth 1 resource)))
                (cl-assert (eq source (marker-buffer (nth 2 resource))))
                (cl-assert (eq source (marker-buffer (nth 3 resource)))))
              (when other (set-window-buffer other destination))
              (with-current-buffer destination (erase-buffer) (insert "Destination"))
              (let ((overriding-terminal-local-map (make-sparse-keymap)))
                (define-key overriding-terminal-local-map (kbd "C-c t")
                            (lambda () (interactive)
                              (if other (other-window 1) (switch-to-buffer destination))))
                (define-key overriding-terminal-local-map (kbd "C-c b")
                            (lambda () (interactive)
                              (if other (other-window -1) (switch-to-buffer source))))
                (execute-kbd-macro (kbd "C-c t"))
                (cl-assert (eq destination (current-buffer)))
                (cl-assert (eq (selected-window) (or other host)))
                (dolist (app apps) (cl-assert (not (emacs-tui-live-p app))))
                (dolist (resource resources)
                  (cl-assert (not (frame-live-p (nth 0 resource))))
                  (cl-assert (not (buffer-live-p (nth 1 resource))))
                  (cl-assert (not (marker-buffer (nth 2 resource))))
                  (cl-assert (not (marker-buffer (nth 3 resource)))))
                (cl-assert (not (memq #'emacs-tui--popup-post-command post-command-hook)))
                (execute-kbd-macro (kbd "M-> x"))
                (cl-assert (equal (buffer-string) "Destinationx"))
                (execute-kbd-macro (kbd "C-c b")))
              (cl-assert (eq host (selected-window)))
              (cl-assert (eq source (current-buffer)))
              (cl-assert emacs-tui-multi-popup-demo-mode)
              (cl-assert (null emacs-tui-multi-popup-demo--sessions))
              (cl-assert (= index emacs-tui-multi-popup-demo--index))
              (cl-assert (equal positions emacs-tui-multi-popup-demo--positions))
              (cl-assert (equal text (buffer-string)))
              (cl-assert (= position (point)))
              (cl-assert (equal undo buffer-undo-list))
              (when other (delete-window other))
              (redisplay t)
              (let ((windows (window-state-get (frame-root-window parent))))
                (execute-kbd-macro (kbd "C-c 0"))
                (emacs-tui-multi-popup-smoke--frames parent)
                (cl-assert (equal windows (window-state-get (frame-root-window parent)))))
              (cl-assert (equal positions emacs-tui-multi-popup-demo--positions))
              (cl-assert (eq (plist-get (nth index emacs-tui-multi-popup-demo--objects) :id)
                             (plist-get (emacs-tui-current-item
                                         (emacs-tui-multi-popup-demo--session 'objects)) :id)))))
        (when (buffer-live-p destination) (kill-buffer destination))))))

(defun emacs-tui-multi-popup-smoke ()
  "Toggle and compose three real child frames without replacing their source."
  (cl-assert (not noninteractive))
  (save-window-excursion
    (let ((before (frame-list)) (parent (selected-frame)) source gallery)
      (unwind-protect
          (progn
            (setq gallery (emacs-tui-gallery))
              (emacs-tui-set-selection gallery 'demos 'multi-popup)
              (execute-kbd-macro (kbd "RET"))
              (cl-assert (string-match-p
                          "C-c 0"
                          (emacs-tui--view-text (emacs-tui--resolve-view gallery 'tour))))
              (execute-kbd-macro (kbd "C-c C-o"))
              (cl-assert (not (emacs-tui-live-p gallery)))
            (setq source (current-buffer))
            (let ((host (selected-window)) (text (buffer-string)) (position (point))
                  (windows (window-state-get (frame-root-window parent))))
              (redisplay t)
              ;; Let real focus events arrive; never repair focus in this test.
              (sit-for 0.05)
              (cl-assert (eq parent (selected-frame)))
              (cl-assert (eq host (selected-window)))
              (emacs-tui-multi-popup-smoke--frames parent)
              (dolist (step '((objects . "C-c 1") (details . "C-c 2") (keys . "C-c 3")))
                (let* ((id (car step))
                       (old (emacs-tui-multi-popup-demo--session id))
                       (siblings (cl-remove-if
                                  (lambda (entry) (eq id (car entry)))
                                  (copy-sequence emacs-tui-multi-popup-demo--sessions))))
                  (execute-kbd-macro (kbd (cdr step)))
                  (cl-assert (not (emacs-tui-live-p old)))
                  (dolist (entry siblings)
                    (cl-assert (eq (cdr entry) (emacs-tui-multi-popup-demo--session (car entry)))))
                  (execute-kbd-macro (kbd (cdr step)))
                  (cl-assert (not (eq old (emacs-tui-multi-popup-demo--session id))))
                  (emacs-tui-multi-popup-smoke--frames parent)))
              (let* ((details (emacs-tui-multi-popup-demo--session 'details))
                     (child (emacs-tui--workspace-frame details))
                     (place (frame-position child)))
                (execute-kbd-macro (kbd "C-c C-p M-n"))
                (cl-assert (equal place (frame-position child)))
                (cl-assert (eq 'valve (plist-get (emacs-tui-current-item
                                                (emacs-tui-multi-popup-demo--session 'objects)) :id)))
                (cl-assert (string-match-p "Return valve"
                                          (emacs-tui--view-text
                                           (emacs-tui--resolve-view details 'details)))))
              ;; Partial visibility -> none -> all, retaining application state.
              (execute-kbd-macro (kbd "C-c 2 C-c 0"))
              (cl-assert (not emacs-tui-multi-popup-demo--sessions))
              (cl-assert emacs-tui-multi-popup-demo-mode)
              (execute-kbd-macro (kbd "M-n C-c 0"))
              (emacs-tui-multi-popup-smoke--frames parent)
              (cl-assert (eq 'sensor (plist-get (emacs-tui-current-item
                                               (emacs-tui-multi-popup-demo--session 'objects)) :id)))
              ;; Native deletion of one child must leave its siblings usable.
              (delete-frame (emacs-tui--workspace-frame
                             (emacs-tui-multi-popup-demo--session 'keys)) t)
              (cl-assert (not (emacs-tui-multi-popup-demo--session 'keys)))
              (cl-assert (emacs-tui-multi-popup-demo--session 'objects))
              (execute-kbd-macro (kbd "C-c 3"))
              (emacs-tui-multi-popup-smoke--scroll)
              (emacs-tui-multi-popup-smoke--pan)
              (emacs-tui-multi-popup-smoke--size)
              (emacs-tui-multi-popup-smoke--pin)
              (emacs-tui-multi-popup-smoke--resize-failure)
              (emacs-tui-multi-popup-smoke--frames parent)
              (emacs-tui-multi-popup-smoke--placements parent)
              (cl-assert (equal windows (window-state-get (frame-root-window parent))) nil
                         "Source window state changed: before=%S after=%S"
                         windows (window-state-get (frame-root-window parent)))
              (cl-assert (equal text (buffer-string)))
              (cl-assert (= position (point)))
              (cl-assert (null buffer-undo-list))
              ;; Navigation intentionally updates native window buffer history.
              ;; Keep the original exact-state check above around popup actions;
              ;; the departure helper checks reopening against its new baseline.
              (emacs-tui-multi-popup-smoke--departures source parent)
              (execute-kbd-macro "x")
              (undo-boundary)
              (undo-only 1)
              (cl-assert (equal text (buffer-string)))
              (cl-assert (= position (point)))
              (cl-assert (eq host (selected-window)))
              (execute-kbd-macro (kbd "C-g C-c 0 C-c C-q"))
              (cl-assert (not emacs-tui-multi-popup-demo-mode))
              (cl-assert (not emacs-tui-multi-popup-demo--sessions))
              (cl-assert (null (cl-set-difference (frame-list) before)))
              ;; Major-mode replacement closes every owned frame and binding.
              (emacs-tui-multi-popup-demo-mode 1)
              (text-mode)
              (cl-assert (not emacs-tui-multi-popup-demo-mode))
              (cl-assert (null (cl-set-difference (frame-list) before)))
              (emacs-tui-multi-popup-demo-mode 1)
              (kill-buffer source)
              (cl-assert (null (cl-set-difference (frame-list) before)))))
        (when gallery (emacs-tui-close gallery))
        (when (buffer-live-p source) (kill-buffer source))))))

(provide 'emacs-tui-multi-popup-smoke)
;;; emacs-tui-multi-popup-smoke.el ends here
