(setq load-prefer-newer t)
(require 'cl-lib)
(require 'emacs-tui-completion)
(require 'elisp-mode)

(defvar emacs-tui-completion-smoke--source nil)
(defvar emacs-tui-completion-smoke--window nil)
(defvar emacs-tui-completion-smoke--parent nil)
(defvar emacs-tui-completion-smoke--frames nil)
(defvar emacs-tui-completion-smoke--supported nil)
(defvar emacs-tui-completion-smoke--app nil)
(defvar emacs-tui-completion-smoke--text nil)
(defvar emacs-tui-completion-smoke--point nil)
(defvar emacs-tui-completion-smoke--phase 1)
(defvar emacs-tui-completion-smoke--attempts 0)
(defvar emacs-tui-completion-smoke--timer nil)
(defvar emacs-tui-completion-smoke--exits nil)

(defun emacs-tui-completion-smoke--host ()
  (cl-assert (eq (current-buffer) emacs-tui-completion-smoke--source))
  (cl-assert (eq (selected-window) emacs-tui-completion-smoke--window))
  (cl-assert (eq (selected-frame) emacs-tui-completion-smoke--parent))
  (cl-assert (eq (window-buffer (selected-window)) (current-buffer)))
  (cl-assert (= 1 (length (window-list emacs-tui-completion-smoke--parent 'no-minibuffer)))))

(defun emacs-tui-completion-smoke--fail (err)
  (with-temp-file (getenv "EMACS_TUI_SMOKE_REPORT")
    (insert (format "FAIL completion phase %s: %S\n" emacs-tui-completion-smoke--phase err))
    (when (get-buffer "*Messages*")
      (insert (with-current-buffer "*Messages*" (buffer-string)))))
  (kill-emacs 1))

(defun emacs-tui-completion-smoke--files ()
  (let ((directory (make-temp-file "tui-capf-" t)))
    (unwind-protect
        (let ((prefix (file-name-as-directory directory)))
          (make-directory (expand-file-name "alpha" directory))
          (make-directory (expand-file-name "alpine" directory))
          (erase-buffer)
          (insert prefix "al/keep.txt")
          (goto-char (+ 1 (length prefix) 2))
          (setq buffer-undo-list nil)
          (setq-local completion-at-point-functions
                      (list (lambda ()
                              (list 1 (point-max) #'read-file-name-internal
                                    :exit-function
                                    (lambda (text status)
                                      (push (list text status) emacs-tui-completion-smoke--exits))))))
          (execute-kbd-macro (kbd "C-M-i"))
          (let ((app (emacs-tui-completion--session)))
            (emacs-tui-set-selection app 'candidates "alpha/")
            (let ((buffer-read-only t) (before (buffer-string)))
              (cl-assert (eq 'buffer-read-only
                             (condition-case err (emacs-tui-completion-accept)
                               (buffer-read-only (car err)))))
              (cl-assert (equal before (buffer-string)))
              (cl-assert (emacs-tui-live-p app)))
            (execute-kbd-macro (kbd "TAB"))
            (cl-assert (equal (concat prefix "alpha/keep.txt") (buffer-string)))
            (cl-assert (equal (list (list (concat prefix "alpha/") 'exact))
                              emacs-tui-completion-smoke--exits))
            (cl-assert (not (emacs-tui-live-p app)))
            (execute-kbd-macro (kbd "C-/"))
            (cl-assert (equal (concat prefix "al/keep.txt") (buffer-string)))
            (cl-assert (not emacs-tui-completion--context))
            (cl-assert (= 1 (length emacs-tui-completion-smoke--exits)))))
      (delete-directory directory t))))

(defun emacs-tui-completion-smoke--finish ()
  (with-current-buffer emacs-tui-completion-smoke--source
    (when emacs-tui-completion-smoke--supported
      (emacs-tui-completion-smoke--files)
      ;; Changing major mode must dispose before local state disappears.
      (erase-buffer) (insert "ma")
      (setq-local completion-at-point-functions
                  (list (lambda () (list 1 (point-max) '("mapcar" "mapconcat")))))
      (execute-kbd-macro (kbd "C-M-i"))
      (let ((app (emacs-tui-completion--session)))
        (text-mode)
        (cl-assert (not (emacs-tui-live-p app)))
        (cl-assert (not emacs-tui-completion-mode))
        (cl-assert (not (local-variable-p 'completion-in-region-function))))
      (cl-assert (not (memq #'emacs-tui-completion--post-command post-command-hook))))
    (emacs-tui-completion-smoke--host))
  (cl-assert (equal (frame-list) emacs-tui-completion-smoke--frames))
  (cl-assert (null emacs-tui--sessions))
  (cancel-timer emacs-tui-completion-smoke--timer)
  (with-temp-file (getenv "EMACS_TUI_SMOKE_REPORT")
    (insert (if emacs-tui-completion-smoke--supported
                (format "PASS Emacs %s; native CAPF popup paint; real elisp provider/styles; host typing/focus/layout; same-child filtering; selection/move; accept/native undo; file base/suffix; exact exit once; read-only retry; resize=120->90->140; major-mode cleanup\n" emacs-version)
              (format "PASS Emacs %s; unsupported CAPF presentation rejected atomically; resize=120->90->140; positive native presentation NOT exercised\n" emacs-version))))
  (kill-emacs 0))

(defun emacs-tui-completion-smoke--poll ()
  (condition-case err
      (progn
        (cl-incf emacs-tui-completion-smoke--attempts)
        (when (> emacs-tui-completion-smoke--attempts 100) (error "Completion resize did not settle"))
        (redisplay t)
        (when (and (= (frame-width emacs-tui-completion-smoke--parent)
                      (if (= 1 emacs-tui-completion-smoke--phase) 90 140))
                   (or (not emacs-tui-completion-smoke--supported)
                       (equal (emacs-tui--geometry emacs-tui-completion-smoke--app)
                              (emacs-tui--workspace-geometry emacs-tui-completion-smoke--app))))
          (with-current-buffer emacs-tui-completion-smoke--source
            (emacs-tui-completion-smoke--host)
            (cl-assert (equal emacs-tui-completion-smoke--text (buffer-string)))
            (cl-assert (= emacs-tui-completion-smoke--point (point)))
            (when emacs-tui-completion-smoke--supported
              (cl-assert (emacs-tui-live-p emacs-tui-completion-smoke--app))))
          (if (= 1 emacs-tui-completion-smoke--phase)
              (progn (setq emacs-tui-completion-smoke--phase 2 emacs-tui-completion-smoke--attempts 0)
                     (with-temp-file (getenv "EMACS_TUI_SMOKE_READY") (insert "2")))
            (emacs-tui-completion-smoke--finish))))
    ((error quit) (emacs-tui-completion-smoke--fail err))))

(defun emacs-tui-completion-smoke--start ()
  (condition-case err
      (progn
        (switch-to-buffer (get-buffer-create "*CAPF host*"))
        (emacs-lisp-mode)
        (insert (make-string 35 ?\n))
        (goto-char (point-min)) (forward-line 17)
        (insert (make-string 54 ?\s) "(map")
        (save-excursion (insert ")"))
        (setq buffer-undo-list nil)
        (setq emacs-tui-completion-smoke--source (current-buffer)
              emacs-tui-completion-smoke--window (selected-window)
              emacs-tui-completion-smoke--parent (selected-frame)
              emacs-tui-completion-smoke--frames (frame-list)
              emacs-tui-completion-smoke--supported (emacs-tui-popup-supported-p))
        (if (not emacs-tui-completion-smoke--supported)
            (let ((windows (window-state-get)) (text (buffer-string))
                  (frontend completion-in-region-function))
              (cl-assert (eq 'user-error
                             (condition-case err (emacs-tui-completion-mode 1)
                               (user-error (car err)))))
              (cl-assert (not emacs-tui-completion-mode))
              (cl-assert (eq frontend completion-in-region-function))
              (cl-assert (equal windows (window-state-get)))
              (cl-assert (equal text (buffer-string))))
          (emacs-tui-completion-mode 1)
          (let ((before (buffer-string)) (point (point)))
            (execute-kbd-macro (kbd "C-M-i"))
            (cl-assert (equal before (buffer-string))) (cl-assert (= point (point))))
          (let* ((app (emacs-tui-completion--session))
                 (child (emacs-tui--workspace-frame app))
                 (selected (emacs-tui-current-item app)))
            (execute-kbd-macro (kbd "M-n"))
            (cl-assert (not (equal selected (emacs-tui-current-item app))))
            (execute-kbd-macro (kbd "M-p"))
            (cl-assert (equal selected (emacs-tui-current-item app)))
            (execute-kbd-macro (kbd "C-c C-p"))
            (cl-assert (eq 'west emacs-tui-completion-position))
            (emacs-tui-set-selection app 'candidates "mapcar")
            (redisplay t)
            (with-temp-file (getenv "EMACS_TUI_SMOKE_PAINT") (insert "Completion "))
            (execute-kbd-macro "ca")
            (cl-assert (eq app (emacs-tui-completion--session)))
            (cl-assert (eq child (emacs-tui--workspace-frame app)))
            (cl-assert (equal "mapcar" (plist-get (emacs-tui-current-item app) :value)))
            (execute-kbd-macro (kbd "TAB"))
            (cl-assert (not (emacs-tui-live-p app)))
            (cl-assert (equal "mapcar)" (buffer-substring (- (point) 6) (1+ (point)))))
            (execute-kbd-macro (kbd "C-/"))
            (cl-assert (equal "mapca)" (buffer-substring (- (point) 5) (1+ (point)))))
            (cl-assert (not emacs-tui-completion--active))
            (execute-kbd-macro (kbd "C-M-i"))
            (setq emacs-tui-completion-smoke--app (emacs-tui-completion--session))))
        (emacs-tui-completion-smoke--host)
        (setq emacs-tui-completion-smoke--text (buffer-string)
              emacs-tui-completion-smoke--point (point))
        (with-temp-file (getenv "EMACS_TUI_SMOKE_READY") (insert "1"))
        (setq emacs-tui-completion-smoke--timer
              (run-at-time 0.05 0.05 #'emacs-tui-completion-smoke--poll)))
    ((error quit) (emacs-tui-completion-smoke--fail err))))

(add-hook 'emacs-startup-hook (lambda () (run-at-time 0.1 nil #'emacs-tui-completion-smoke--start)))
